<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<%- partial('partial/head') %>
<% var isHome = (page.path === 'index.html' || page.path === ''); %>
<body<%= isHome ? ' data-noheader' : '' %>>
  <% if (isHome) { %>
    <div class="home-bg" id="home-bg" aria-hidden="true">
      <div id="bg-bubbles"></div>
    </div>
  <% } %>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>
  <div class="site-wrapper">
    <% if (page.path !== 'index.html' && page.path !== '') { %>
      <%- partial('partial/header') %>
    <% } %>
    <main class="main-content">
      <%- body %>
    </main>
    <% if (page.path !== 'index.html' && page.path !== '') { %>
      <%- partial('partial/footer') %>
    <% } %>
  </div>
  <button class="back-to-top" id="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>

  <div class="search-overlay" id="search-overlay" data-search-url="<%- url_for(config.search.path) %>" aria-hidden="true">
    <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
      <div class="search-input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input type="search" id="search-input" placeholder="搜索文章…" autocomplete="off" spellcheck="false" aria-label="搜索文章">
        <button class="search-close" id="search-close" type="button" aria-label="关闭搜索">Esc</button>
      </div>
      <div class="search-results" id="search-results" role="listbox"></div>
      <div class="search-empty" id="search-empty" hidden></div>
    </div>
  </div>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <figure class="lightbox-figure">
      <div class="lightbox-stage" id="lightbox-stage"></div>
      <figcaption class="lightbox-caption" id="lightbox-caption"></figcaption>
    </figure>
  </div>

  <script src="<%- url_for('/js/app.js?v=4') %>"></script>
  <script src="<%- url_for('/js/code.js?v=4') %>"></script>
  <% if (isHome) { %>
    <script>
      // 首页背景动效：Bubbles（带 lazy 加载 + 失败降级）
      window.__MONO_BG = {
        threeUrl: '<%- url_for('/vendor/three.module.js') %>',
        coreUrl: '<%- url_for('/js/bubbles-core.js') %>'
      };
    </script>
    <script src="<%- url_for('/js/background.js?v=4') %>"></script>
  <% } %>
</body>
</html>
