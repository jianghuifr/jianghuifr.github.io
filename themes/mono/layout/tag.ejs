<%
var tagEntity = site.tags.findOne({ name: page.tag });
var tagTotal = tagEntity ? tagEntity.posts.length : page.posts.length;
%>
<div class="tag-page">
  <header class="list-header">
    <h1>标签：<%= page.tag %></h1>
    <p class="list-meta"><%= tagTotal %> 篇文章</p>
  </header>
  <div class="post-list">
    <% page.posts.each(function(post){ %>
      <%- partial('partial/post-card', {post: post}) %>
    <% }) %>
  </div>
</div>
<%- partial('partial/pagination') %>
